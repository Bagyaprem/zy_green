# ZYGREEN Admin Console — environment variables
#
# This admin app is a separate application from the legacy customer dashboard
# that used to live in this repo, so it uses its own VITE_ADMIN_SUPABASE_*
# variables instead of the old app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
# This avoids ever silently reusing the old app's production credentials.
#
# Copy this file to .env (or add these two lines to your existing .env) and
# fill in your own project's values. Until real values are provided, the app
# falls back to obviously-fake placeholders and every Supabase call will fail
# gracefully (handled by loading/empty/error states) rather than crash.

VITE_ADMIN_SUPABASE_URL=https://your-project.supabase.co
VITE_ADMIN_SUPABASE_ANON_KEY=your-anon-key-here
